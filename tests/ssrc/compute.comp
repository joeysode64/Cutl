#version 450
#extension GL_EXT_buffer_reference2 : require

layout(buffer_reference, std430, buffer_reference_align = 4) buffer DataBuffer {
	float values[];
};

layout(push_constant) uniform PushConstants {
	DataBuffer data;
} pc;

layout(local_size_x = 64) in;

void main() {
	uint i = gl_GlobalInvocationID.x;
	pc.data.values[i] *= 2.0;
}
